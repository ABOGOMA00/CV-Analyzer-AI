# This file contains environment variables for the CV Analyzer AI.
# Since the application runs completely locally, no external API keys are needed!

# Configure allowed origins for CORS (default is *)
ALLOWED_ORIGINS="*"

# Override the SQLite database if you want a custom path or another DB engine.
DATABASE_URL="sqlite:///./cv_analyzer.db"

# Optional: point to a local SentenceTransformer snapshot if auto-detection is not enough.
EMBED_MODEL_PATH=""

# Configure log level
LOG_LEVEL="INFO"
